wait = function(duration: int) do end
choice = function(question: string) : int do return 0 end
event = function(name: string) do end
describe = function(name: string, count: int, enabled: bool) : string do return "" end
# A function type of the native module, used by a native function taking a script function (a callback)
Handler = function(value: int) do end
register = function(name: string, handler: Handler) do end
