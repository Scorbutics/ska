# Web build of a ska game (Emscripten, WebAssembly) : include this file before the engine (add_subdirectory), then call
# ska_web_executable. The SDL3 libraries are built for the web by tools/web/build_deps.sh (CMAKE_PREFIX_PATH : their
# prefix). Configure with emcmake :
#   emcmake cmake -S . -B build-web -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=<deps prefix>
#
# The web has no dynamic library : the game, the engine and SDL are linked in one module, and the functions the engine
# loads by name (SDLLibrary...) are found in a table generated here (Base/DynamicLibrary/OSSpecific/DynamicLibraryStatic.h).
# There is no thread : the browser calls each frame of the game (GameCore::run).

set(SKA_WEB_DIR ${CMAKE_CURRENT_LIST_DIR}/..)

if(EMSCRIPTEN)
	# The engine uses exceptions (ex : TerminateProcessException)
	add_compile_options(-fwasm-exceptions)
	add_link_options(-fwasm-exceptions)
	set(CMAKE_EXECUTABLE_SUFFIX ".html")
endif()

# ska_web_executable(<name> GAME <game library target> [ASSETS <directory>...] [SHELL <html shell file>])
#   The page <name>.html (and its .js, .wasm, .data) runs the game. The ASSETS directories (relative to the game
#   directory : the working directory of the game) are packed in <name>.data, at the same places.
function(ska_web_executable NAME)
	cmake_parse_arguments(WEB "" "GAME;SHELL;ASSETS_ROOT" "ASSETS;LINK_OPTIONS" ${ARGN})

	find_package(SDL3 REQUIRED CONFIG)
	find_package(SDL3_image REQUIRED CONFIG)
	find_package(SDL3_ttf REQUIRED CONFIG)
	find_package(SDL3_mixer REQUIRED CONFIG)

	# The functions the engine loads by name, in the definitions of its libraries (*_NAME_DEFINE(..., "name"))
	set(libraries
		${SKA_WEB_DIR}/ska_core/src/src/Core/SDLLibrary.cpp
		${SKA_WEB_DIR}/ska_draw/src/src/Graphic/SDLImageLibrary.cpp
		${SKA_WEB_DIR}/ska_draw/src/src/Graphic/SDLTTFLibrary.cpp
		${SKA_WEB_DIR}/ska_audio/src/src/Audio/SDLMixerLibrary.cpp)
	set(entries "")
	foreach(library ${libraries})
		file(STRINGS ${library} definitions REGEX "_NAME_DEFINE\\([^\"]*\"[A-Za-z0-9_]+\"\\)")
		foreach(definition ${definitions})
			string(REGEX MATCH "\"([A-Za-z0-9_]+)\"" _ "${definition}")
			string(APPEND entries "\t\t{ \"${CMAKE_MATCH_1}\", reinterpret_cast<ska::ska_default_function_ptr>(&${CMAKE_MATCH_1}) },\n")
		endforeach()
	endforeach()
	set(symbols ${CMAKE_CURRENT_BINARY_DIR}/${NAME}_symbols.cpp)
	file(WRITE ${symbols}.in "// Generated by ska_web_executable (cmake/SkaWeb.cmake) : the functions the engine loads by name
#include <SDL3/SDL.h>
// SDL_SetMainReady (the engine has its own main)
#define SDL_MAIN_HANDLED
#include <SDL3/SDL_main.h>
#include <SDL3_image/SDL_image.h>
#include <SDL3_ttf/SDL_ttf.h>
#include <SDL3_mixer/SDL_mixer.h>
#include \"Base/DynamicLibrary/OSSpecific/DynamicLibraryStatic.h\"

// The entry points of the game library (ska_main, GameLibrary)
extern \"C\" void init();
extern \"C\" int run();

const ska::StaticLibrarySymbol* ska::StaticLibrarySymbols() {
	static const StaticLibrarySymbol symbols[] = {
${entries}		{ \"init\", reinterpret_cast<ska::ska_default_function_ptr>(&init) },
		{ \"run\", reinterpret_cast<ska::ska_default_function_ptr>(&run) },
		{ nullptr, nullptr }
	};
	return symbols;
}
")
	configure_file(${symbols}.in ${symbols} COPYONLY)

	add_executable(${NAME} ${symbols} $<TARGET_OBJECTS:ska_main>)
	# The whole game library : its registrations (static objects) are not referenced by the launcher
	target_link_libraries(${NAME} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${WEB_GAME}>"
		SDL3_ttf::SDL3_ttf-static SDL3_image::SDL3_image-static SDL3_mixer::SDL3_mixer-static SDL3::SDL3-static)
	target_include_directories(${NAME} PRIVATE ${SKA_WEB_DIR}/external/skabase/src/src ${SKA_WEB_DIR}/external/skalog/src/src)

	# The memory grows as needed ; the scripts (skalang) need a larger stack than the default one
	set(options -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=8MB -sFORCE_FILESYSTEM=1 -lidbfs.js -sEXIT_RUNTIME=0
		"-sEXPORTED_RUNTIME_METHODS=FS,IDBFS,ENV,addRunDependency,removeRunDependency")
	if(NOT WEB_ASSETS_ROOT)
		set(WEB_ASSETS_ROOT ${CMAKE_CURRENT_SOURCE_DIR})
	endif()
	foreach(asset ${WEB_ASSETS})
		list(APPEND options "--preload-file=${WEB_ASSETS_ROOT}/${asset}@/${asset}")
	endforeach()
	if(WEB_SHELL)
		list(APPEND options "--shell-file=${WEB_SHELL}")
	endif()
	target_link_options(${NAME} PRIVATE ${options} ${WEB_LINK_OPTIONS})
endfunction()
