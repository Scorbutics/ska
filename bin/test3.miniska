IOLog = import "bind:std.native.io.log"
Point = import "point"

run = function(parameters: string[]) do
    i = 0
    i = i + 1
    test = Point.Fcty(14 + i, 0-i)

    IOLog.print("Test : " + (test.x: string) + ", " + (test.y: string))

    i = i + 1
    test2 = Point.Fcty(14 + i, 0-i)

    IOLog.print("Test : " + (test.x: string) + ", " + (test.y: string))
    IOLog.print("Test2 : " + (test2.x: string) + ", " + (test2.y: string))

end
