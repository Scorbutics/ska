# Engine functions available to the scripts : Engine = import "bind:ska.engine"

# Suspends the script for a duration (milliseconds)
wait = function(milliseconds: int) do end
log = function(message: string) do end
# Random number between 0 and max - 1
random = function(max: int) : int do return 0 end

# Entities are "int" handles. A handle of a removed entity is not valid anymore : using it is an error.
# Entity that triggered the script (-1 if none)
origin = function() : int do return 0 end
# Entity with the given name (ex : "trainer"), -1 if not found
entity = function(name: string) : int do return 0 end
# A line about an entity, for the tools : its handle, its name, its position (pixels), its components
describe = function(entity: int) : string do return "" end
# True when the entity was not removed (false for -1)
exists = function(entity: int) : bool do return false end

# Removes a component of an entity (ex : "InputComponent" : it stops reacting to the player inputs),
# until "enableComponent" puts it back as it was
disableComponent = function(entity: int, component: string) do end
enableComponent = function(entity: int, component: string) do end

# Game variables, saved with the game
variable = function(name: string) : int do return 0 end
setVariable = function(name: string, value: int) do end
# Every game variable, "name=value", sorted by name
variables = function() : string[] do return []: string end

# Starts another script (it runs on its own : this script does not wait for it)
script = function(file: string, arguments: string[]) do end

# Hooks : a function called each time an engine event happens (it runs as a script : it can wait).
# The events are declared by the game (an unknown event is an error).
EntityHook = function(entity: int) do end
# Calls "handler" with the entity concerned by the event, until "removeHook" : returns the hook id
on = function(event: string, handler: EntityHook) : int do return 0 end
removeHook = function(hook: int) do end
